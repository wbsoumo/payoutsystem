<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Route the homepage request directly to the index.php file
    RewriteRule ^$ public/index.php [L]

    # Route migration runner directly to public folder
    RewriteRule ^run_migration.php$ public/run_migration.php [L]
    
    # If the requested path exists inside the public directory, rewrite to it directly
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Route all other requests to index.php if the file or folder doesn't exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php/$1 [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php84” package as the “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
